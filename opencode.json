{
  "$schema": "https://opencode.ai",
  "autoupdate": true,
  "model": "opencode/deepseek-v4-flash-free",
  "plugin": ["opencode-autosave-conversation", "@slkiser/opencode-quota"],
  "instructions": [
    ".opencode/rules/terminal-rules.md",
    "context_lake/latest.json"
  ],
  "experimental": {
    "hook": {
      "session_completed": [
        { "command": ["python", "context_lake/capture.py", "--window", "session-completed", "--project-root", "."] }
      ]
    }
  },
  "mcp": {
    "sonarqube": {
      "type": "remote",
      "url": "https://mcp.sonarqube.com/mcp",
      "oauth": {}
    }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "bash": {
      "Remove-Item*": "deny",
      "rm *": "deny",
      "rm -rf*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git merge*": "deny",
      "git commit --amend*": "deny",
      "git checkout -B*": "deny",
      "*": "allow"
    },
    "webfetch": "allow"
  }
}
