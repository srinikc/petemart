{
  "name": "productforge",
  "version": "1.0.0",
  "description": "ProductForge — Agentic Product Studio (monorepo)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node dev-server.js",
    "dev:all": "node dev-server.js",
    "dev:console": "node dev-server.js -p 3000",
    "dev:product": "node dev-server.js -p 3001",
    "dev:qa": "node dev-server.js -p 3458",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "stop:all": "powershell -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-dev.ps1",
    "serve:qa": "powershell -ExecutionPolicy Bypass -File scripts/serve-qa-dashboard.ps1",
    "build": "npm run build -w @productforge/framework-console && npm run build -w @productforge/petemart",
    "build:console": "npm run build -w @productforge/framework-console",
    "build:product": "npm run build -w @productforge/petemart",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0-beta.3",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0-beta.3"
  }
}