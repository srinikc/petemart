{
  "name": "petemart-unified",
  "version": "1.0.0",
  "description": "PeteMart — Unified Next.js App (UI + API + DB integration)",
  "private": true,
  "scripts": {
    "dev": "node dev-server.js -p 3000",
    "dev:clean": "node -e \"const f=require('fs');['.next','dev-err.log','dev-out.log','dev-server.log'].forEach(p=>f.existsSync(p)&&f.rmSync(p,{recursive:true,force:true}))\"",
    "dev:bg": "powershell -File scripts/start-dev.ps1",
    "dev:stop": "powershell -File scripts/stop-dev.ps1",
    "stop:all": "powershell -File scripts/stop-all.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --open",
    "test:api": "jest --passWithNoTests --forceExit --detectOpenHandles",
    "qa:collect": "node scripts/collect-test-results.js",
    "qa:full": "npx vitest run __tests__/agentic-console/",
    "qa:api": "npx vitest run __tests__/agentic-console/api/",
    "qa:comp": "npx vitest run __tests__/agentic-console/comp/",
    "qa:e2e": "npx playwright test e2e/agentic-console/",
    "qa:report": "vitest run --reporter=json --outputFile=qa-dashboard/vitest-output.json && node scripts/collect-test-results.js",
    "qa:security": "npx vitest run __tests__/agentic-console/security/",
    "qa:sse": "npx vitest run __tests__/agentic-console/sse/",
    "qa:dashboard": "vitest --ui",
    "qa:run": "node scripts/run-tests.js",
    "qa:run:ci": "node scripts/run-tests.js --env=ci",
    "qa:sanity": "npx vitest run __tests__/agentic-console/unit/",
    "qa:release": "node scripts/run-tests.js --tier=release",
    "qa:list": "node scripts/run-tests.js --list",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:headed": "npx playwright test --headed",
    "e2e:debug": "npx playwright test --debug",
    "e2e:all": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:visual": "npx playwright test e2e/visual-regression.spec.ts e2e/agentic-console/visual-regression.spec.ts",
    "e2e:visual:update": "npx playwright test e2e/visual-regression.spec.ts e2e/agentic-console/visual-regression.spec.ts --update-snapshots",
    "e2e:report": "npx playwright show-report qa-dashboard/playwright-report",
    "e2e:install": "npx playwright install --with-deps",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:db:migrate": "npx supabase db push",
    "supabase:db:seed": "npx supabase db execute --file supabase/seed.sql",
    "supabase:db:reset": "npx supabase db reset",
    "supabase:types": "npx supabase gen types typescript --local > types/supabase.ts",
    "db:migrate": "psql -h localhost -U postgres -d petemart -f supabase/migrations/001_initial_schema.sql && psql -h localhost -U postgres -d petemart -f supabase/migrations/002_rls_policies.sql && psql -h localhost -U postgres -d petemart -f supabase/migrations/003_auth_triggers.sql",
    "db:seed": "psql -h localhost -U postgres -d petemart -f supabase/seed.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "setup": "npm install && npm run db:setup",
    "qa:start": "powershell -File scripts/serve-qa-dashboard.ps1",
    "qa:stop": "powershell -File scripts/stop-qa-dashboard.ps1",
    "serve:qa": "npx next start -p 3458",
    "serve:qa:standalone": "node .next/standalone/server.js -p 3458",
    "docker:build": "docker build -t petemart-unified .",
    "docker:run": "docker run -p 3000:3000 petemart-unified",
    "vercel:deploy": "vercel --prod",
    "railway:deploy": "railway up",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "precommit": "lint-staged && tsc --noEmit && npm test",
    "a11y": "npx playwright test e2e/accessibility.spec.ts",
    "perf:lighthouse": "npx lhci collect --config=lighthouse.config.js && npx lhci assert --config=lighthouse.config.js",
    "perf:lighthouse:report": "npx lhci collect --config=lighthouse.config.js && npx lhci assert --config=lighthouse.config.js && npx lhci upload --config=lighthouse.config.js",
    "loadtest:k6": "k6 run scripts/k6-loadtest.js",
    "loadtest:k6:staging": "k6 run -e BASE_URL=https://staging.petemart.com scripts/k6-loadtest.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@testing-library/dom": "^10.4.1",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.14.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0",
    "zod-validation-error": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0-beta.3",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0-beta.3"
  }
}
