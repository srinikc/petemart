{
  "name": "productforge",
  "version": "1.0.0",
  "description": "ProductForge — Agentic Product Studio (monorepo)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:console": "node dev-server.js -p 3000",
    "dev:product": "node scripts/dev-product.js -p 3001",
    "dev:qa": "npx next start apps/framework-console -p 3458",
    "build": "npm run build -w @productforge/framework-console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}