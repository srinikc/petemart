  "system_context": {
    "internal_systems": [
      {"name": "Web Application", "technology": "Next.js 14", "purpose": "Customer browsing, purchasing, merchant management"},
      {"name": "Mobile Apps", "technology": "React Native", "purpose": "iOS & Android native apps for customers, couriers"},
      {"name": "API Gateway & Services", "technology": "Kong + NestJS Microservices", "purpose": "API routing, auth, rate limiting, business logic"},
      {"name": "Admin Console", "technology": "Next.js", "purpose": "Platform administration, merchant management, analytics"},
      {"name": "Courier App", "technology": "React Native", "purpose": "Delivery partner order management"}
    ],
    "external_systems": [
      {"name": "Razorpay", "purpose": "Payment processing, subscriptions"},
      {"name": "WhatsApp Business API", "purpose": "Messaging, enquiry tracking, OTP"},
      {"name": "Google Maps API", "purpose": "Geocoding, distance matrix, directions"},
      {"name": "ShipRocket", "purpose": "National shipping logistics"},
      {"name": "MCX/IBJA", "purpose": "Live bullion rates for gold/silver"},
      {"name": "Jitsi/WebRTC", "purpose": "Video call appointments"}
    ]
  },
  "microservices": [
    {"service": "User Service", "technology": "NestJS", "database": "PostgreSQL", "replicas": {"min": 2, "max": 8}, "responsibilities": ["Auth (OTP/JWT)", "User profiles", "Addresses"]},
    {"service": "Product Service", "technology": "NestJS", "database": "MongoDB + Elasticsearch", "replicas": {"min": 2, "max": 10}, "responsibilities": ["Catalog CRUD", "Inventory", "Full-text search", "Product images"]},
    {"service": "Order Service", "technology": "NestJS", "database": "PostgreSQL + Redis", "replicas": {"min": 2, "max": 12}, "responsibilities": ["Multi-store cart", "Checkout engine", "Consolidation logic", "Order lifecycle"]},
    {"service": "Merchant Service", "technology": "NestJS", "database": "PostgreSQL", "replicas": {"min": 2, "max": 8}, "responsibilities": ["Store management", "Subscription plans", "Onboarding workflow"]},
    {"service": "Payment Service", "technology": "NestJS", "database": "PostgreSQL", "replicas": {"min": 2, "max": 6}, "responsibilities": ["Razorpay integration", "Payment reconciliation", "Merchant settlements"]},
    {"service": "Delivery Service", "technology": "NestJS", "database": "PostgreSQL + Redis", "replicas": {"min": 2, "max": 8}, "responsibilities": ["Zone management", "Courier dispatch", "Route optimization", "Live tracking"]},
    {"service": "Notification Service", "technology": "NestJS", "database": "Redis", "replicas": {"min": 2, "max": 10}, "responsibilities": ["Push (FCM)", "Email (SendGrid)", "SMS (Twilio)", "WhatsApp"]},
    {"service": "AI Service", "technology": "Python FastAPI", "database": "PostgreSQL (pgvector) + S3", "replicas": {"min": 1, "max": 6}, "responsibilities": ["Virtual try-on", "Recommendations", "Similar products", "Semantic search"]},
    {"service": "Bullion Service", "technology": "NestJS", "database": "TimescaleDB + Redis", "replicas": {"min": 1, "max": 4}, "responsibilities": ["Live rate fetching", "Rate caching", "Price recalculation"]},
    {"service": "Analytics Service", "technology": "NestJS", "database": "ClickHouse/PostgreSQL", "replicas": {"min": 2, "max": 6}, "responsibilities": ["Event processing", "Merchant analytics", "Admin dashboards", "BI exports"]}
  ],
  "api_endpoints": {
    "user": ["POST /api/v1/auth/login", "POST /api/v1/auth/register", "GET /api/v1/users/profile", "PUT /api/v1/users/addresses"],
    "product": ["GET /api/v1/products", "GET /api/v1/products/:id", "GET /api/v1/products/search", "GET /api/v1/products/:id/try-on"],
    "merchant": ["GET /api/v1/merchants/:slug", "GET /api/v1/merchants/:id/products", "POST /api/v1/merchants/register", "PUT /api/v1/merchants/subscription"],
    "cart": ["POST /api/v1/cart/add", "PUT /api/v1/cart/update", "DELETE /api/v1/cart/:item", "GET /api/v1/cart/summary"],
    "order": ["POST /api/v1/orders/checkout", "GET /api/v1/orders/:id", "GET /api/v1/orders/history", "PUT /api/v1/orders/:id/status"],
    "payment": ["POST /api/v1/payments/initiate", "POST /api/v1/payments/razorpay/webhook", "GET /api/v1/payments/:id"],
    "delivery": ["POST /api/v1/delivery/assign", "GET /api/v1/delivery/:id/track", "PUT /api/v1/delivery/:id/status", "GET /api/v1/delivery/zones"],
    "notification": ["POST /api/v1/notifications/send", "PUT /api/v1/notifications/device-token", "GET /api/v1/notifications/history"],
    "ai": ["POST /api/v1/ai/try-on", "POST /api/v1/ai/recommendations", "GET /api/v1/ai/similar/:id"],
    "bullion": ["GET /api/v1/bullion/rates", "GET /api/v1/bullion/history"],
    "analytics": ["GET /api/v1/analytics/merchant/:id/sales", "GET /api/v1/analytics/admin/revenue"],
    "admin": ["GET /api/v1/admin/merchants/pending", "PUT /api/v1/admin/merchants/:id/approve", "GET /api/v1/admin/system/health"]
  },
  "webhook_events": [
    {"event": "order.created", "publisher": "Order Service", "consumers": ["Notification", "Delivery", "Analytics"]},
    {"event": "order.payment_confirmed", "publisher": "Payment Service", "consumers": ["Order", "Notification", "Analytics"]},
    {"event": "order.shipped", "publisher": "Delivery Service", "consumers": ["Order", "Notification"]},
    {"event": "order.delivered", "publisher": "Delivery Service", "consumers": ["Order", "Notification", "Analytics"]},
    {"event": "merchant.registered", "publisher": "Merchant Service", "consumers": ["Admin", "Notification"]},
    {"event": "merchant.subscription_changed", "publisher": "Merchant Service", "consumers": ["Billing", "Analytics"]},
    {"event": "product.out_of_stock", "publisher": "Product Service", "consumers": ["Merchant", "Notification"]},
    {"event": "bullion.rate_updated", "publisher": "Bullion Service", "consumers": ["Product"]},
    {"event": "payment.dispute", "publisher": "Payment Service", "consumers": ["Admin", "Merchant"]}
  ],
  "data_architecture": {
    "primary_database": "PostgreSQL 16 (AWS RDS)",
    "document_store": "MongoDB (AWS DocumentDB)",
    "cache": "Redis 7 (AWS ElastiCache Cluster)",
    "search": "Elasticsearch (AWS OpenSearch)",
    "object_storage": "AWS S3 + CloudFront",
    "time_series": "TimescaleDB (PostgreSQL extension)",
    "key_tables": [
      "users", "merchants", "products", "product_variants", "product_images",
      "orders", "order_items", "order_status_history",
      "payments", "payment_transactions",
      "deliveries", "delivery_stops", "delivery_tracking",
      "cart_items", "coupons",
      "subscriptions", "subscription_plans",
      "reviews", "bullion_rates",
      "try_on_results", "video_call_appointments",
      "feature_flags", "audit_logs"
    ]
  },
