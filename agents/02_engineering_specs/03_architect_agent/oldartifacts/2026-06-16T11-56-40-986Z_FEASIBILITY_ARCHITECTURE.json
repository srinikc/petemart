{
  "document_metadata": {
    "title": "PeteMart Full Product Enterprise Architecture Blueprint",
    "version": "1.0",
    "author": "Senior Enterprise Solution Architect (Agent 03)",
    "date": "2026-06-15",
    "status": "Final",
    "derived_from": ["PRD v2.0", "Idea Proposal v1.3", "Business Revenue Model v1.4", "PRD Config v1.0"]
  },
  "architecture_overview": {
    "pattern": "API-first, Event-driven, Cloud-native Microservices",
    "frontend": "Next.js 14 (Web) + React Native (Mobile)",
    "backend": "NestJS (Node.js) + Python FastAPI (AI)",
    "database": "PostgreSQL 16 + MongoDB + Redis + Elasticsearch",
    "infrastructure": "AWS EKS (Kubernetes) + RDS + ElastiCache + S3 + CloudFront",
    "api_gateway": "Kong (Open Source)",
    "message_queue": "RabbitMQ (Amazon MQ)",
    "target_merchants": 5000,
    "target_markets": 21,
    "target_cities": "Bangalore (primary) → Chennai, Hyderabad, Mumbai (expansion)",
    "cost_at_scale": "~₹7,78,000/month (5,000 merchants)"
  },
  "architecture_principles": [
    "API-First: All capabilities exposed via RESTful APIs before UI",
    "Event-Driven: Async message passing for cross-service communication",
    "Cloud-Native: Horizontal scaling, containerized microservices on Kubernetes",
    "Offline-First: Mobile apps work with degraded connectivity via SQLite local cache",
    "Multi-Tenant: Isolated merchant data with shared infrastructure using RLS",
    "Observability: OpenTelemetry tracing, Prometheus metrics, ELK logging",
    "Secure by Default: Defense in depth, zero-trust network, encryption everywhere",
    "Cost-Optimized: Auto-scaling, spot instances, CDN caching, read replicas"
  ],
