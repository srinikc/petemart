  "api_strategy": {
    "architecture": "API Gateway pattern with rate-limiting, auth middleware, and request validation",
    "protocols": ["REST (primary)", "GraphQL (analytics)", "WebSocket (live tracking)"],
    "response_format": {
      "success": {"success": true, "data": {}, "meta": {"page": 1, "per_page": 20, "total": 0, "total_pages": 0}, "error": null},
      "error": {"success": false, "data": null, "error": {"code": "ERROR_CODE", "message": "Human readable", "details": []}}
    },
    "rate_limiting": {
      "strategy": "Redis-based sliding window",
      "public_endpoints": "60-200 requests/min",
      "auth_endpoints": "5-30 requests/min",
      "admin_endpoints": "10-30 requests/min"
    },
    "endpoints": {
      "public": [
        {"method": "GET", "path": "/api/markets", "description": "List all Pete markets", "rate_limit": "100/min"},
        {"method": "GET", "path": "/api/markets/:slug", "description": "Market details with merchants", "rate_limit": "100/min"},
        {"method": "GET", "path": "/api/merchants/:slug", "description": "Merchant microsite data", "rate_limit": "100/min"},
        {"method": "GET", "path": "/api/products", "description": "Search/filter products", "rate_limit": "200/min"},
        {"method": "GET", "path": "/api/products/:id", "description": "Product details", "rate_limit": "200/min"},
        {"method": "GET", "path": "/api/bullion/rates", "description": "Live gold/silver rates", "rate_limit": "60/min"},
        {"method": "POST", "path": "/api/auth/otp/send", "description": "Send OTP", "rate_limit": "5/min per phone"},
        {"method": "POST", "path": "/api/auth/otp/verify", "description": "Verify OTP", "rate_limit": "10/min per phone"}
      ],
      "customer": [
        {"method": "GET", "path": "/api/cart", "description": "Get current cart"},
        {"method": "POST", "path": "/api/cart/items", "description": "Add to cart"},
        {"method": "POST", "path": "/api/orders", "description": "Place order"},
        {"method": "GET", "path": "/api/orders", "description": "Order history"},
        {"method": "POST", "path": "/api/payments/verify", "description": "Verify payment"},
        {"method": "GET", "path": "/api/tracking/:id", "description": "Live tracking"}
      ],
      "merchant": [
        {"method": "GET", "path": "/api/merchant/dashboard", "description": "Dashboard summary"},
        {"method": "GET", "path": "/api/merchant/products", "description": "Product list"},
        {"method": "POST", "path": "/api/merchant/products", "description": "Create product"},
        {"method": "POST", "path": "/api/merchant/products/bulk", "description": "Bulk CSV upload"},
        {"method": "GET", "path": "/api/merchant/orders", "description": "Order list"},
        {"method": "GET", "path": "/api/merchant/analytics", "description": "Sales analytics"}
      ],
      "admin": [
        {"method": "GET", "path": "/api/admin/dashboard", "description": "Platform overview"},
        {"method": "GET", "path": "/api/admin/merchants", "description": "Merchant list"},
        {"method": "PUT", "path": "/api/admin/merchants/:id/approve", "description": "Approve merchant"},
        {"method": "GET", "path": "/api/admin/config", "description": "Platform config"},
        {"method": "PUT", "path": "/api/admin/feature-flags", "description": "Toggle flag"},
        {"method": "GET", "path": "/api/admin/reports", "description": "Revenue reports"}
      ]
    },
    "webhook_events": [
      {"event": "payment.captured", "source": "Razorpay", "destination": "API Gateway", "description": "Payment successful"},
      {"event": "payment.failed", "source": "Razorpay", "destination": "API Gateway", "description": "Payment failed"},
      {"event": "order.created", "source": "Order Service", "destination": "Notification Service", "description": "New order alert"},
      {"event": "order.status_changed", "source": "Order Service", "destination": "All consumers", "description": "Status transition"},
      {"event": "merchant.registered", "source": "Auth Service", "destination": "Admin Service", "description": "New merchant signup"},
      {"event": "delivery.assigned", "source": "Delivery Service", "destination": "Courier App", "description": "Courier assigned"},
      {"event": "delivery.status_update", "source": "Courier App", "destination": "Order Service", "description": "GPS + status update"}
    ]
  },
  "data_architecture": {
    "core_tables": [
      "users", "merchants", "products", "product_images", "product_variants",
      "orders", "order_items", "payments", "deliveries", "delivery_status_logs",
      "carts", "cart_items", "addresses", "reviews",
      "markets", "cities", "delivery_zones",
      "merchant_subscriptions", "feature_flags", "audit_logs",
      "whatsapp_click_logs", "analytics_events"
    ],
    "caching_strategy": [
      {"pattern": "cart:{session_id}", "ttl": "24h", "store": "Redis", "purpose": "Guest cart"},
      {"pattern": "cart:{user_id}", "ttl": "24h", "store": "Redis", "purpose": "User cart"},
      {"pattern": "product:{id}", "ttl": "5min", "store": "Redis", "purpose": "Product details"},
      {"pattern": "merchant:{slug}", "ttl": "5min", "store": "Redis", "purpose": "Merchant microsite"},
      {"pattern": "market:{slug}", "ttl": "10min", "store": "Redis", "purpose": "Market page"},
      {"pattern": "rates:bullion", "ttl": "30s", "store": "Redis", "purpose": "Live bullion rates"},
      {"pattern": "session:{token}", "ttl": "7d", "store": "Redis", "purpose": "JWT session"},
      {"pattern": "rate_limit:{ip}:{endpoint}", "ttl": "1min", "store": "Redis", "purpose": "Rate limiting"}
    ]
  },
  "security_framework": {
    "authentication": ["Phone OTP (Supabase Auth)", "JWT Access Token (15min)", "Refresh Token (7 days)"],
    "authorization": ["RBAC Roles (customer/merchant/admin/courier)", "Row-Level Security (PostgreSQL)", "API Middleware Route Guards"],
    "security_controls": [
      {"control": "OTP Rate Limiting", "implementation": "Redis + Supabase", "detail": "Max 3 OTP sends/hour per phone"},
      {"control": "Passwordless Auth", "implementation": "Phone OTP only", "detail": "No password storage risk"},
      {"control": "RLS Policies", "implementation": "PostgreSQL", "detail": "Merchants see only their data"},
      {"control": "API Rate Limiting", "implementation": "Upstash Redis", "detail": "Per-endpoint, per-IP, per-user"},
      {"control": "Input Validation", "implementation": "Zod schemas", "detail": "All API inputs validated"},
      {"control": "SQL Injection Prevention", "implementation": "Drizzle ORM", "detail": "Parameterized queries"},
      {"control": "Encryption at Rest", "implementation": "PostgreSQL + S3 SSE", "detail": "AES-256"},
      {"control": "Encryption in Transit", "implementation": "TLS 1.3", "detail": "All traffic HTTPS"},
      {"control": "Webhook Verification", "implementation": "HMAC-SHA256", "detail": "Razorpay signature verify"},
      {"control": "DDoS Protection", "implementation": "Cloudflare WAF", "detail": "Rate limiting + challenge"},
      {"control": "Audit Logging", "implementation": "audit_logs table", "detail": "All admin actions logged"}
    ]
  },
