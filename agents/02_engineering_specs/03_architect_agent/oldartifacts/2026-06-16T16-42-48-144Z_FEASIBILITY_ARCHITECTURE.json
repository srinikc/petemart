  "architecture_overview": {
    "platform_name": "PeteMart",
    "platform_type": "Hyperlocal digital commerce marketplace",
    "target_merchants": 5000,
    "target_markets": "21 historic Pete markets of Old Bangalore",
    "interaction_modes": ["Mode A (Direct Purchase)", "Mode B (WhatsApp Enquiry)", "Mode C (Visit Store)"],
    "architecture_style": "API-First, Event-Driven Microservices",
    "deployment_model": "Cloud-Native (Vercel + AWS ECS Fargate)",
    "key_design_principles": [
      "API-First Design",
      "Event-Driven Architecture",
      "Tenant Isolation via RLS",
      "Offline Resilience",
      "Progressive Enhancement",
      "Cost-Aware Scaling",
      "Security by Design"
    ]
  },
  "key_architectural_decisions": [
    {
      "decision": "Frontend Framework",
      "choice": "Next.js 15 (Web) + React Native/Expo (Mobile)",
      "rationale": "Shared TypeScript types, SSR for SEO, code reuse between web and mobile"
    },
    {
      "decision": "Backend Architecture",
      "choice": "Next.js API Routes → Node.js Microservices",
      "rationale": "Unified API layer initially, gradual extraction to microservices as scale demands"
    },
    {
      "decision": "Database",
      "choice": "Supabase (PostgreSQL) → Aurora PostgreSQL",
      "rationale": "Start free with Supabase, scale with pgBouncer + read replicas on Aurora"
    },
    {
      "decision": "Cache Layer",
      "choice": "Redis (Upstash → ElastiCache)",
      "rationale": "Sub-millisecond cart/price lookups, session store, rate limiting"
    },
    {
      "decision": "Message Queue",
      "choice": "BullMQ + Redis",
      "rationale": "Order processing, notification dispatch, async task execution"
    },
    {
      "decision": "AI Inference",
      "choice": "Replicate + Hugging Face + Custom ONNX",
      "rationale": "Cost-effective inference with GPU auto-scaling"
    },
    {
      "decision": "Payment Gateway",
      "choice": "Razorpay",
      "rationale": "Indian market leader, subaccount routing for merchant settlements, escrow support"
    },
    {
      "decision": "Hosting",
      "choice": "Vercel → AWS ECS Fargate",
      "rationale": "Serverless start with Vercel, containerized scale with AWS"
    },
    {
      "decision": "CDN & Security",
      "choice": "Cloudflare",
      "rationale": "Global edge caching, DDoS protection, WAF, rate limiting"
    }
  ],
