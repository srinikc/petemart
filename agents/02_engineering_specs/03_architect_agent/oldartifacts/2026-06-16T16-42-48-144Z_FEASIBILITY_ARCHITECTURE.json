    "auto_scaling_rules": [
      {"service": "Web (Vercel)", "metric": "Requests/sec", "scale_out": ">1000 rps", "scale_in": "<200 rps", "min": 0, "max": "∞"},
      {"service": "API (ECS)", "metric": "CPU > 70%", "scale_out": "+2 tasks", "scale_in": "-1 task", "min": 2, "max": 20},
      {"service": "Order Service", "metric": "Queue depth > 100", "scale_out": "+2 tasks", "scale_in": "-1 task", "min": 2, "max": 10},
      {"service": "AI Service", "metric": "GPU util > 80%", "scale_out": "+1 instance", "scale_in": "-1 instance", "min": 0, "max": 4},
      {"service": "Database", "metric": "Connections > 80%", "scale_out": "Add replica", "scale_in": "Remove replica", "min": 1, "max": 5},
      {"service": "Redis", "metric": "Memory > 70%", "scale_out": "Scale up node", "scale_in": "Scale down", "min": "1GB", "max": "10GB"}
    ],
    "database_scaling_path": [
      "Phase 1: Supabase Free (500MB, 2 connections)",
      "Phase 2: Supabase Pro (8GB, 120 connections)",
      "Phase 3: Supabase Team (16GB, pgBouncer)",
      "Phase 4: Aurora Serverless v2 (ACU 8-64)",
      "Phase 5: Aurora Cluster (Writer + 3 Read Replicas + pgBouncer)"
    ]
  },
