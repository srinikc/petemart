    "architecture_overview": {
      "pattern": "Cloud-Native, API-First, Event-Driven Microservices",
      "principles": [
        "API-First",
        "Event-Driven",
        "CQRS",
        "Zero Trust Security",
        "Multi-Tenant Isolation",
        "Observability by Default",
        "Cost-Aware Scaling"
      ]
    },
    "ui_stack": {
      "web": {
        "framework": "React 18 + Next.js 14 (App Router)",
        "ui_library": "Tailwind CSS + Radix UI + shadcn/ui",
        "state_management": "Zustand + TanStack Query",
        "animation": "Framer Motion",
        "forms": "React Hook Form + Zod",
        "testing": "Vitest + Testing Library + MSW",
        "performance_targets": {
          "lcp": "< 2.0s",
          "tbt": "< 200ms",
          "cls": "< 0.1",
          "lighthouse_score": 95
        }
      },
      "mobile": {
        "framework": "React Native 0.76 + Expo 51",
        "navigation": "Expo Router (file-based)",
        "ui": "Tamagui (compile-time CSS-in-JS)",
        "offline": "WatermelonDB + NetInfo",
        "maps": "react-native-maps (Mapbox)",
        "push": "Expo Push Notifications + Firebase",
        "ota_updates": "EAS Update",
        "testing": "Detox (E2E) + Jest (Unit)",
        "performance_targets": {
          "scroll_fps": 60,
          "cold_start": "< 2.5s",
          "app_size": "< 25MB"
        },
        "code_reuse_with_web": "70%"
      }
    },
    "api_strategy": {
      "protocols": [
        "REST (OpenAPI 3.0) for CRUD",
        "GraphQL for complex aggregations",
        "gRPC for inter-service communication",
        "WebSocket for real-time updates"
      ],
      "api_gateway": "Kong Gateway 3.6 + Envoy Proxy",
      "service_mesh": "Istio 1.21",
      "versioning": "/api/v1/*, /api/v2/*, /api/experimental/*",
      "rate_limiting": {
        "anonymous": "60 req/min",
        "customer": "1000 req/min",
        "merchant": "2000 req/min",
        "b2b_buyer": "3000 req/min",
        "admin": "5000 req/min",
        "internal": "10000 req/min"
      }
    },
    "caching_strategy": {
      "layers": [
        {
          "layer": "CDN (CloudFront)",
          "cache_type": "Static assets, images, merchant microsites",
          "ttl": "24h (assets), 1h (microsites)"
        },
        {
          "layer": "API Gateway (Kong)",
          "cache_type": "GET responses, product listings",
          "ttl": "30s default"
        },
        {
          "layer": "Application (Redis)",
          "components": [
            "Session Store (TTL: 24h)",
            "Data Cache (Product, Pricing)",
            "Rate Limit Counters (Sliding Window)",
            "Query Cache (TTL: 30s)",
            "Locking (Redlock)",
            "Geospatial (Store Search)"
          ]
        },
        {
          "layer": "Database (PostgreSQL)",
          "cache_type": "Shared buffers (25% of RAM), Materialized views"
        }
      ],
      "invalidation": {
        "cdn": "Cache purge API on asset update",
        "api_gateway": "TTL expiry",
        "redis": "Pub/Sub invalidation on write",
        "postgresql": "Materialized view refresh (5 min cron)"
      }
    },
    "message_queues": {
      "event_streaming": {
        "technology": "Apache Kafka 3.6",
        "topics": [
          "order.events (12 partitions)",
          "payment.events (8 partitions)",
          "notification.req (6 partitions)",
          "inventory.events (10 partitions)",
          "delivery.events (6 partitions)",
          "analytics.events (8 partitions)"
        ]
      },
      "task_queues": {
        "technology": "RabbitMQ 3.13",
        "queues": [
          "email_queue → Email Service (2 workers)",
          "sms_queue → SMS Service (1 worker)",
          "image_process → Image Processing (3 workers)",
          "report_gen → Report Generation (2 workers)",
          "export_queue → Data Export (1 worker)"
        ]
      },
      "dead_letter_queue": {
        "order_events": { "max_retries": 3, "retry_delay": "Exponential (1s, 5s, 30s)", "dlq_action": "Alert ops team" },
        "payment_events": { "max_retries": 5, "retry_delay": "Linear (10s each)", "dlq_action": "Manual reconciliation" },
        "notification_req": { "max_retries": 3, "retry_delay": "Exponential (2s, 10s, 60s)", "dlq_action": "Log + discard" },
        "delivery_events": { "max_retries": 3, "retry_delay": "Linear (5s each)", "dlq_action": "Re-queue after fix" }
      }
    },
    "security": {
      "layers": [
        "Layer 1: Network Security (VPC, WAF, Security Groups)",
        "Layer 2: Authentication & Authorization (OAuth 2.0 + OIDC, JWT, RBAC/ABAC)",
        "Layer 3: API Security (Kong rate limiting, mTLS)",
        "Layer 4: Data Security (AES-256 at rest, TLS 1.3 in transit)",
        "Layer 5: Application Security (XSS prevention, CSRF, CSP)",
        "Layer 6: Compliance & Privacy (GDPR, India DPDP, audit trails)"
      ],
      "authentication_flows": [
        "Customer: OTP/Google OAuth → JWT (15 min) + Refresh Token (7 days)",
        "Merchant: Email/Password + TOTP 2FA → JWT with merchant claims",
        "Admin: SSO (SAML 2.0) + Hardware MFA → JIT privileged access"
      ],
      "encryption": {
        "passwords": "bcrypt (cost 12)",
        "pii": "AES-256-GCM + TLS 1.3 (AWS KMS)",
        "payment": "Tokenized (PCI-DSS) + TLS 1.3 (Vault)",
        "api_keys": "HashiCorp Vault + TLS 1.3",
        "session_tokens": "JWT in memory + TLS 1.3",
        "database": "AES-256 (RDS) + TLS 1.3"
      }
    },
    "infrastructure": {
      "cloud_provider": "AWS",
      "region": "ap-south-1 (Mumbai)",
      "availability_zones": ["ap-south-1a", "ap-south-1b", "ap-south-1c"],
      "container_orchestration": "Amazon EKS",
      "node_groups": [
        { "type": "General Purpose", "instance": "t3.2xlarge", "spec": "8 vCPU, 32 GB", "scaling": "5-20 nodes", "cpu_threshold": "70%" },
        { "type": "Memory Optimized", "instance": "r6i.2xlarge", "spec": "8 vCPU, 64 GB", "scaling": "3-15 nodes", "memory_threshold": "75%" },
        { "type": "Compute Optimized", "instance": "c6i.2xlarge", "spec": "8 vCPU, 16 GB", "scaling": "2-10 nodes", "cpu_threshold": "60%" }
      ],
      "database_topology": {
        "primary": "PostgreSQL 16 (RDS Multi-AZ, 5000 IOPS)",
        "replicas": [
          "Read Replica 1 (Analytics, 3000 IOPS)",
          "Read Replica 2 (Search Index, 3000 IOPS)"
        ],
        "connection_pooling": "PgBouncer (sidecar per service)",
        "backup": "Automated daily snapshots + WAL archiving (7 days)"
      },
      "monitoring": {
        "stack": "OpenTelemetry + Prometheus + Grafana + Loki + Jaeger",
