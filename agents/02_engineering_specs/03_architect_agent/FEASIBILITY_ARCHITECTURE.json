    "architecture_decision_records": [
      {
        "id": "ADR-001",
        "title": "React Native over Flutter for Mobile",
        "decision": "React Native + Expo 51",
        "rationale": "70% code reuse with web, TypeScript ecosystem, faster developer onboarding",
        "consequences": "Slightly larger app size (25MB vs 15MB), but faster feature delivery"
      },
      {
        "id": "ADR-002",
        "title": "Kafka + RabbitMQ Dual Queue Strategy",
        "decision": "Deploy both Kafka and RabbitMQ",
        "rationale": "Kafka for event streaming (order lifecycle), RabbitMQ for task queues (notifications)",
        "consequences": "Higher infrastructure cost but optimal tooling for each use case"
      },
      {
        "id": "ADR-003",
        "title": "Polyglot Persistence",
        "decision": "PostgreSQL (primary), MongoDB (catalog), TimescaleDB (analytics)",
        "rationale": "Different data characteristics require different database paradigms",
        "consequences": "Complex operations but optimized performance per data type"
      },
      {
        "id": "ADR-004",
        "title": "Next.js ISR for Merchant Microsites",
        "decision": "Incremental Static Regeneration (ISR) with 60s revalidation",
        "rationale": "5000 merchants, each needing a unique microsite with product listings",
        "consequences": "~2ms page loads for most visitors, stale data max 60s"
      },
      {
        "id": "ADR-005",
        "title": "AWS over GCP/Azure",
        "decision": "Amazon Web Services",
        "rationale": "Best service breadth, Bangalore region availability, cost-effective for startup"
      }
    ]
